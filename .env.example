# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Cache Configuration (TTL in seconds - 900s = 15 minutes)
CACHE_TTL_SECONDS=900

# Rate Limiting (100 requests per 1 minute window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Request Timeout (in milliseconds)
UPSTREAM_TIMEOUT_MS=8000

# Optional Generative AI Assistant (Google Gemini 1.5 Flash)
# If omitted, system seamlessly uses guardrailed clinical deterministic guidance
GEMINI_API_KEY=
